{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Start Dev Environment",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "make",
      "runtimeArgs": ["start-dev"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Start Staging Environment",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "make",
      "runtimeArgs": ["start-staging"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Dashboard (Expo)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/services/dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
