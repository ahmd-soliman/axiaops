{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Seed",
      "type": "shell",
      "command": "docker compose -f ${workspaceFolder}/docker-compose.yml up -d postgres && until docker exec axiaops-postgres pg_isready -U axiaops_owner &>/dev/null; do sleep 1; done && ./scripts/seed_test_data.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "Dashboard",
      "type": "shell",
      "command": "npx expo start --web --non-interactive",
      "options": {
        "cwd": "${workspaceFolder}/services/dashboard"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "Bundled"
        }
      },
      "presentation": {
        "panel": "dedicated"
      }
    },
    {
      "label": "Prepare",
      "type": "shell",
      "command": "docker compose -f ${workspaceFolder}/docker-compose.yml up -d postgres && until docker exec axiaops-postgres pg_isready -U axiaops_owner &>/dev/null; do sleep 1; done",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
