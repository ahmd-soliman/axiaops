# Playwright e2e runner image.
#
# DESIGN: bake every network-dependent step into CACHED build layers, so
# steady-state runs need ZERO network. This matters because the runner's only
# usable resolver is the LAN's (192.168.1.1), which is intermittently
# unavailable — a runtime `apt`/`npm` (every run) turns any DNS blip into a red
# build. Baked layers are pulled from the runner's persistent /var/lib/docker
# cache instead, so only the FIRST build (or a dep change) touches the network.
#
# The dashboard *application* is NOT needed here (it's compiled into the nginx
# `dashboard` service already) — only package*.json (for `npm ci`) + the e2e/
# specs. Pinned to the @playwright/test version in package.json so the image's
# bundled browsers match (no `npx playwright install` needed).
#
# NB: the build runs under the LEGACY builder (DOCKER_BUILDKIT=0 in the Makefile)
# so these RUN steps resolve via the docker daemon's network (which works when
# the LAN resolver is up) rather than buildkit's separate, DNS-less sandbox.
FROM mcr.microsoft.com/playwright:v1.60.0-jammy

# psql for the seeder (auth.setup.ts → scripts/seed_test_data.sh --seed-existing-org).
# Own layer → cached unless this line changes. GNU `date` is already in the base.
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends postgresql-client \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Deps as their own cached layer — busts only when the lockfile changes.
COPY services/dashboard/package.json services/dashboard/package-lock.json ./
RUN npm ci

# Specs LAST: a per-commit spec change busts only this cheap COPY, leaving the
# apt + npm layers (the network-dependent ones) cache-warm. `npm run e2e`
# resolves `playwright test -c e2e/playwright.config.ts` from /work.
COPY services/dashboard/e2e ./e2e
RUN rm -rf e2e/playwright-report e2e/test-results e2e/.auth

# The canonical seeder, referenced as /repo/scripts/seed_test_data.sh by
# auth.setup.ts (only this script is needed for the --seed-existing-org path).
COPY scripts/seed_test_data.sh /repo/scripts/seed_test_data.sh

CMD ["npm", "run", "e2e"]
