# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.
#
# EXPO_PUBLIC_ prefix is required for Expo to expose vars to client code.
# Never put secrets (client_secret, API keys) in this file — frontend only.

# Kinde Auth — public values only
EXPO_PUBLIC_KINDE_ISSUER=https://your-tenant.kinde.com
EXPO_PUBLIC_KINDE_CLIENT_ID=your-client-id

# API URL — backend ingestion service
EXPO_PUBLIC_API_URL=http://localhost:8081
