# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Set to "true" to use fixture data instead of real AWS
DEV_MODE=false

# Required when DEV_MODE=false
AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-central-1

# Optional — only needed if not using AWS CLI credentials (~/.aws/credentials)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Date range — how far back to fetch cost data (default: 30 days)
# Option A: number of days back from today
# DAYS_BACK=90
# Option B: explicit range (YYYY-MM-DD)
# START_DATE=2025-01-01
# END_DATE=2025-12-31
