# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

AWS_ACCOUNT_ID=123456789012
AWS_REGION=eu-central-1

# Optional — only needed if not using AWS CLI credentials (~/.aws/credentials)
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Date range — how far back to fetch cost data (default: 30 days)
# Option A: number of days back from today
# DAYS_BACK=90
# Option B: explicit range (YYYY-MM-DD)
# START_DATE=2025-01-01
# END_DATE=2025-12-31

# Scheduler — how often to check for overdue accounts (default: 60m in production)
# Set to a short value when running smoke tests locally so TestScheduledAutoScan passes.
SCAN_INTERVAL=10s
KINDE_ISSUER=https://your-tenant.kinde.com
KINDE_CLIENT_ID=your-client-id

# Redis — JWKS cache, rate limiting, scan job queue
# Leave unset to fall back to in-memory (dev default)
# REDIS_URL=redis://localhost:6379
