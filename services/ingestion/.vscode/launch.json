{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run ingestion (dev)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/main.go",
      "env": {
        "DEV_MODE": "true",
        "FIXTURE_PATH": "fixtures/costs.json"
      }
    },
    {
      "name": "Run ingestion (production)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/main.go",
      "env": {
        "AWS_ACCOUNT_ID": "",
        "AWS_REGION": "eu-central-1"
      }
    }
  ]
}
