AWSTemplateFormatVersion: '2010-09-09'
Description: AxiaOps CUR Integration - Creates IAM Role and Athena/S3 infrastructure for Cost and Usage Reports.

Parameters:
  ExternalId:
    Type: String
    Default: '{{.ExternalID}}'
    Description: The External ID provided by AxiaOps for secure role assumption.

  # --- Resource naming. GlueDatabaseName/GlueTableName/AthenaWorkgroupName/
  # RoleName default to whatever the dashboard's Advanced Configuration
  # (BillingSourceConfig) has saved for this account — see getCURSetup's
  # ?cur_database/?cur_table/?cur_workgroup/?role_name — so a customer who
  # customized those away from the axiaops_* defaults gets a template that
  # actually matches, instead of silently deploying axiaops_* regardless.
  # ExportName/S3Prefix/BucketSuffix aren't dashboard-editable; override
  # those (e.g. via --parameter-overrides) only to run a second copy of this
  # stack in the same AWS account/region without colliding on names — a
  # parallel test or fresh-install validation stack. Every resource that
  # used to repeat a literal now derives it from a Parameter instead, so
  # changing a name can't leave a stale copy of the literal behind elsewhere
  # in the template. That's exactly how a hand-edited "-test" copy of this
  # file once drifted: its Data Export was renamed but the Glue table's
  # storage location, hardcoded separately, was not.
  ExportName:
    Type: String
    Default: axiaops
    Description: >-
      Name of the CUR 2.0 Data Export (AWS::BCMDataExports::Export). AWS
      nests delivered data under this same name inside S3Prefix
      (<S3Prefix>/<ExportName>/data/...) — the Glue table's storage location
      is computed from this parameter and S3Prefix, never hardcoded
      separately, so the two can't drift out of sync again.
  S3Prefix:
    Type: String
    Default: cur
    Description: S3 key prefix under CURDataBucket that the Data Export delivers to.
  BucketSuffix:
    Type: String
    Default: ''
    Description: >-
      Optional suffix appended to both S3 bucket names (e.g. "-test"). Bucket
      names are otherwise derived from account ID + region, which is unique
      per account/region but still collides if you deploy a second stack
      into the same account/region — set this to avoid that.
  GlueDatabaseName:
    Type: String
    Default: '{{.GlueDatabaseName}}'
    Description: Glue Data Catalog database name. Must match the account's cur_database.
  GlueTableName:
    Type: String
    Default: '{{.GlueTableName}}'
    Description: Glue table name. Must match the account's cur_table.
  AthenaWorkgroupName:
    Type: String
    Default: '{{.AthenaWorkgroupName}}'
    Description: Athena workgroup name. Must match the account's cur_workgroup.
  RoleName:
    Type: String
    Default: '{{.RoleName}}'
    Description: Name of the IAM role AxiaOps assumes to scan this account.
  PolicyName:
    Type: String
    Default: AxiaOpsPolicy
    Description: Name of the IAM managed policy attached to RoleName.

Resources:
  # 1. Bucket for raw CUR data delivery from AWS
  CURDataBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub 'axiaops-cur-data-${AWS::AccountId}-${AWS::Region}${BucketSuffix}'
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  # 1b. Policy to allow AWS Data Exports (CUR 2.0) to write to the CUR bucket.
  # Principal and conditions per https://docs.aws.amazon.com/cur/latest/userguide/dataexports-s3-bucket.html —
  # bcm-data-exports.amazonaws.com, scoped to exports created by this account only.
  CURDataBucketPolicy:
    Type: AWS::S3::BucketPolicy
    Properties:
      Bucket: !Ref CURDataBucket
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Sid: EnableAWSDataExportsToWriteToS3
            Effect: Allow
            Principal:
              Service: bcm-data-exports.amazonaws.com
            Action: 's3:PutObject'
            Resource: !Sub 'arn:aws:s3:::${CURDataBucket}/*'
            Condition:
              ArnLike:
                'aws:SourceArn': !Sub 'arn:aws:bcm-data-exports:us-east-1:${AWS::AccountId}:export/*'
              StringEquals:
                'aws:SourceAccount': !Ref 'AWS::AccountId'

  # 2. Bucket for Athena query results
  AthenaQueryResultsBucket:
    Type: AWS::S3::Bucket
    Properties:
      BucketName: !Sub 'axiaops-athena-results-${AWS::AccountId}-${AWS::Region}${BucketSuffix}'
      PublicAccessBlockConfiguration:
        BlockPublicAcls: true
        BlockPublicPolicy: true
        IgnorePublicAcls: true
        RestrictPublicBuckets: true

  # 3. Athena Workgroup
  AxiaOpsWorkgroup:
    Type: AWS::Athena::WorkGroup
    Properties:
      Name: !Ref AthenaWorkgroupName
      WorkGroupConfiguration:
        ResultConfiguration:
          OutputLocation: !Sub 's3://${AthenaQueryResultsBucket}/'

  # AxiaOpsPolicy's first two statements are generated from
  # services/api/internal/api/scan_permissions.go (generalScanPermissions,
  # curAthenaPermissions) — the same list GET /v1/scan-permissions returns to
  # the dashboard for manual access-key setup — so the CFN-managed role and a
  # hand-configured IAM user always need exactly the same permissions. Only
  # the S3 statement stays template-local: it's scoped to the exact buckets
  # this stack just created, which a generic (pre-account) policy display
  # can't know in advance.
  AxiaOpsPolicy:
    Type: AWS::IAM::ManagedPolicy
    Properties:
      ManagedPolicyName: !Ref PolicyName
      Description: Customer managed policy for AxiaOps role
      PolicyDocument:
        Version: '2012-10-17'
        Statement:
          - Effect: Allow
            Action:
{{- range .GeneralActions}}
              - '{{.}}'
{{- end}}
            Resource: '*'
          - Effect: Allow
            Action:
{{- range .CURAthenaActions}}
              - '{{.}}'
{{- end}}
            Resource: '*'
          - Effect: Allow
            # Athena writes query result files to this bucket under the
            # caller's identity — PutObject is required here.
            Action:
              - 's3:GetObject'
              - 's3:PutObject'
              - 's3:ListBucket'
            Resource:
              - !Sub 'arn:aws:s3:::${AthenaQueryResultsBucket}'
              - !Sub 'arn:aws:s3:::${AthenaQueryResultsBucket}/*'
          - Effect: Allow
            # Read-only. The CUR data bucket only ever needs to be written to
            # by bcm-data-exports.amazonaws.com (CURDataBucketPolicy above) —
            # the scanning role/user has no legitimate reason to write into
            # the customer's own billing-data bucket. No PutObject here.
            Action:
              - 's3:GetObject'
              - 's3:ListBucket'
            Resource:
              - !Sub 'arn:aws:s3:::${CURDataBucket}'
              - !Sub 'arn:aws:s3:::${CURDataBucket}/*'

  # 4. IAM Role for AxiaOps to assume
  AxiaOpsRole:
    Type: AWS::IAM::Role
    Properties:
      RoleName: !Ref RoleName
      AssumeRolePolicyDocument:
        Statement:
          - Effect: Allow
            Principal:
              AWS: "arn:aws:iam::{{.AccountID}}:root"
            Action: sts:AssumeRole
            Condition:
              StringEquals:
                "sts:ExternalId": !Ref ExternalId
      ManagedPolicyArns:
        - !Ref AxiaOpsPolicy

  # 5. CUR 2.0 Data Export. Native resource — no custom Lambda needed. Column
  # list is deliberately narrow (only what the amortization query in
  # services/ingestion/internal/provider/aws/cur/query.go reads) since Data
  # Exports lets you choose columns at export time, and Athena bills by bytes
  # scanned: a narrower export means a cheaper query, not just a cheaper
  # export. If query.go starts reading another column, add it here too.
  AxiaOpsCURExport:
    Type: AWS::BCMDataExports::Export
    DependsOn: CURDataBucketPolicy
    Properties:
      Export:
        Name: !Ref ExportName
        DataQuery:
          QueryStatement: >-
            SELECT line_item_usage_account_id, line_item_product_code,
            product_region_code, line_item_resource_id,
            line_item_usage_start_date, line_item_line_item_type,
            line_item_unblended_cost, savings_plan_savings_plan_effective_cost,
            savings_plan_total_commitment_to_date, savings_plan_used_commitment,
            reservation_effective_cost,
            reservation_unused_amortized_upfront_fee_for_billing_period,
            reservation_unused_recurring_fee
            FROM COST_AND_USAGE_REPORT
          TableConfigurations:
            COST_AND_USAGE_REPORT:
              TIME_GRANULARITY: HOURLY
              INCLUDE_RESOURCES: 'TRUE'
              INCLUDE_SPLIT_COST_ALLOCATION_DATA: 'FALSE'
        DestinationConfigurations:
          S3Destination:
            S3Bucket: !Ref CURDataBucket
            S3Prefix: !Ref S3Prefix
            S3Region: !Ref AWS::Region
            S3OutputConfigurations:
              OutputType: CUSTOM
              Format: PARQUET
              Compression: PARQUET
              Overwrite: OVERWRITE_REPORT
        RefreshCadence:
          Frequency: SYNCHRONOUS

  # 6. Glue database/table for Athena. AWS Data Exports does not
  # auto-register a Glue table (unlike legacy CUR's ATHENA artifact, which at
  # least drops a setup template) — see plan open decision #7. Defined
  # explicitly here, matching the export's column selection above and the
  # BILLING_PERIOD=YYYY-MM partitioning Data Exports uses for delivery
  # (https://docs.aws.amazon.com/cur/latest/userguide/dataexports-export-delivery.html).
  # GlueDatabaseName/GlueTableName default to the same names POST
  # /v1/accounts uses for defDB/defTable — keep them in sync if either
  # default changes.
  #
  # Partition projection (not MSCK/a crawler/a Lambda) is what makes new
  # billing periods queryable. Without it, Athena has zero visibility into
  # any BILLING_PERIOD=YYYY-MM folder until something explicitly registers
  # it — the table silently returns 0 rows for data that's actually in S3,
  # every month, for every customer, forever. Projection computes valid
  # partitions from the range/format below instead of needing registration.
  AxiaOpsCURDatabase:
    Type: AWS::Glue::Database
    Properties:
      CatalogId: !Ref AWS::AccountId
      DatabaseInput:
        Name: !Ref GlueDatabaseName

  AxiaOpsCURTable:
    Type: AWS::Glue::Table
    Properties:
      CatalogId: !Ref AWS::AccountId
      DatabaseName: !Ref AxiaOpsCURDatabase
      TableInput:
        Name: !Ref GlueTableName
        TableType: EXTERNAL_TABLE
        Parameters:
          EXTERNAL: 'TRUE'
          'projection.enabled': 'true'
          'projection.billing_period.type': 'date'
          'projection.billing_period.format': 'yyyy-MM'
          'projection.billing_period.interval': '1'
          'projection.billing_period.interval.unit': 'MONTHS'
          'projection.billing_period.range': '2024-01,NOW'
          # Derived from S3Prefix + ExportName (never a separate literal) —
          # this is the exact path AWS Data Exports delivers to:
          # <S3Prefix>/<ExportName>/data/BILLING_PERIOD=.../
          'storage.location.template': !Sub 's3://${CURDataBucket}/${S3Prefix}/${ExportName}/data/BILLING_PERIOD=${!billing_period}/'
        PartitionKeys:
          - Name: billing_period
            Type: string
        StorageDescriptor:
          Location: !Sub 's3://${CURDataBucket}/${S3Prefix}/${ExportName}/data/'
          InputFormat: org.apache.hadoop.hive.ql.io.parquet.MapredParquetInputFormat
          OutputFormat: org.apache.hadoop.hive.ql.io.parquet.MapredParquetOutputFormat
          SerdeInfo:
            SerializationLibrary: org.apache.hadoop.hive.ql.io.parquet.serde.ParquetHiveSerDe
          Columns:
            - {Name: line_item_usage_account_id, Type: string}
            - {Name: line_item_product_code, Type: string}
            - {Name: product_region_code, Type: string}
            - {Name: line_item_resource_id, Type: string}
            - {Name: line_item_usage_start_date, Type: timestamp}
            - {Name: line_item_line_item_type, Type: string}
            - {Name: line_item_unblended_cost, Type: double}
            - {Name: savings_plan_savings_plan_effective_cost, Type: double}
            - {Name: savings_plan_total_commitment_to_date, Type: double}
            - {Name: savings_plan_used_commitment, Type: double}
            - {Name: reservation_effective_cost, Type: double}
            - {Name: reservation_unused_amortized_upfront_fee_for_billing_period, Type: double}
            - {Name: reservation_unused_recurring_fee, Type: double}

Outputs:
  RoleARN:
    Description: Role ARN to paste into AxiaOps
    Value: !GetAtt AxiaOpsRole.Arn
  CURBucketName:
    Description: Bucket name to use when creating the Cost and Usage Report in AWS Billing
    Value: !Ref CURDataBucket
