# Copy to .env and fill in values. Never commit .env.

# Kinde Auth
KINDE_ISSUER=https://your-tenant.kinde.com
KINDE_CLIENT_ID=your-client-id

# Kinde M2M (Management API) — required for the invitation + onboarding flows
# (POST /v1/invitations, DELETE /v1/invitations/{id}, PATCH /v1/organizations/me).
# Create an M2M application in Kinde with these scopes:
#   read:users, create:users, update:user_properties, delete:users,
#   read:organizations, update:organizations,
#   update:organization_users, delete:organization_users
# In dev (DEV_MODE=true) auth is bypassed, so M2M is only needed when exercising
# the invitation flow end-to-end. To run without a real M2M app, set
# KINDE_USE_STUB=true (in-memory stub — never enable in production).
KINDE_M2M_CLIENT_ID=your-m2m-client-id
KINDE_M2M_CLIENT_SECRET=your-m2m-client-secret
# KINDE_MGMT_API_URL=  # override only when the Mgmt API base URL differs from KINDE_ISSUER
# KINDE_USE_STUB=false
# INVITATION_TTL_DAYS=14

# Encryption key for secrets at rest (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-key

# Database
# Application connection (non-owner). Used by the API and ingestion services.
DATABASE_URL=postgres://axiaops:axiaops@localhost:5432/axiaops?sslmode=disable

# Owner/admin connection used for migrations (creates roles/schema/tables/RLS).
# If omitted, DATABASE_URL is used (works only if DATABASE_URL has sufficient privileges).
MIGRATION_DATABASE_URL=postgres://axiaops_owner:axiaops_owner@localhost:5432/axiaops?sslmode=disable

# Server
API_ADDR=:8080

# Redis — JWKS cache, rate limiting, scan job queue
# Leave unset to fall back to in-memory (dev default)
# REDIS_URL=redis://localhost:6379
