# Copy to .env and fill in values. Never commit .env.

# Encryption key for secrets at rest (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-32-byte-hex-key

# Database
# Application connection (non-owner). Used by the API and ingestion services.
DATABASE_URL=postgres://axiaops:axiaops@localhost:5432/axiaops?sslmode=disable

# Owner/admin connection used for migrations (creates roles/schema/tables/RLS).
# If omitted, DATABASE_URL is used (works only if DATABASE_URL has sufficient privileges).
MIGRATION_DATABASE_URL=postgres://axiaops_owner:axiaops_owner@localhost:5432/axiaops?sslmode=disable

# Server
API_ADDR=:8080

# Redis — JWKS cache, rate limiting, scan job queue
# Leave unset to fall back to in-memory (dev default)
# REDIS_URL=redis://localhost:6379

# Invite-email relay (optional) — the global SMTP fallback the InviteMailer
# uses to email an invitation's redemption link when an org has no per-org
# email channel. Leave these unset for local dev: invites then just return the
# link (email_delivery=skipped_no_transport), which is the intended local
# behavior — you don't want `make start-dev` sending real mail. Set them only
# to test invite-email delivery locally. Empty SMTP_HOST = no mailer.
# Target is a Gmail Workspace relay; SMTP_USER/SMTP_PASS need a real mailbox
# with 2SV + an App Password. SMTP_FROM is required once SMTP_HOST is set.
# SMTP_HOST=smtp-relay.gmail.com
# SMTP_PORT=587
# SMTP_USER=notification@axiaops.io
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM=noreply@axiaops.io
# SMTP_FROM_NAME=AxiaOps

# Externally-reachable origin used to build absolute OOB links (invitation +
# password-reset redemption URLs, OIDC redirects). For local invite-email
# testing set it to the dashboard origin the invitee will open
# (http://localhost:5173 under `make start-dev`, http://localhost:8082 under
# `make start-staging`). Empty → relative links the frontend resolves against
# window.location.origin, and the invite mailer skips (skipped_no_public_host).
# PUBLIC_HOST=http://localhost:5173
