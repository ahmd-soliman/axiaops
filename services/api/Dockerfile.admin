# Admin-plane API image (cmd/api-admin) — the staff console backend.
#
# Mirrors services/api/Dockerfile (same module, same base, same RDS CA bundle)
# but compiles ./cmd/api-admin instead of ./cmd/. It is a SEPARATE binary and a
# SEPARATE image so the admin plane stays plane-isolated (saas-platform-admin-
# design §3/§9): different ingress (admin.axiaops.io), staff IdP, not internet-
# facing. Same ECS cluster as the tenant api (§11.2 #8 — resolved: same cluster,
# separate ingress), so the only artifact difference is the binary + ingress.
#
# This file is dormant until services/api/cmd/api-admin/ lands — the
# build:admin-images CI job is `exists:`-guarded on that directory, so a vanilla
# `docker build -f Dockerfile.admin` only succeeds once the binary exists.
FROM golang:1.25-alpine AS builder
WORKDIR /app
COPY services/shared/ /shared/
COPY services/api/go.mod services/api/go.sum ./
RUN go mod download
COPY services/api/ .
# BUILD_TAGS controls B1.7 layer 3 stripping, identically to the tenant api
# image. CI sets BUILD_TAGS=production for the customer/staff-shipping image so
# devmode_production.go hard-wires devModeEnabled() to false. Build the PACKAGE
# (./cmd/api-admin) not a single file, so sibling build-tag-gated files compile.
ARG BUILD_TAGS=
RUN go build -tags "$BUILD_TAGS" -o api-admin ./cmd/api-admin/

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
# AWS RDS CA bundle — the admin plane reads the same RDS over
# sslmode=verify-full, so it needs the same Amazon trust anchor at the same
# region-named path the aws-infra secret references. See deploy/certs/README.md.
COPY deploy/certs/rds-global-bundle.pem /etc/ssl/certs/rds-ca-eu-central-1.pem
WORKDIR /app
COPY --from=builder /app/api-admin .
ARG APP_VERSION=dev
ARG APP_COMMIT_SHA=local
ENV APP_VERSION=$APP_VERSION
ENV APP_COMMIT_SHA=$APP_COMMIT_SHA
# api-admin defaults its listen addr to :8090 (cmd/api-admin/main.go). Pin it to
# :8080 so the image is self-consistent with EXPOSE + HEALTHCHECK below and with
# the TF api_admin service's container port. CI passes the same value in the
# task env; this keeps a plain `docker run` coherent too.
ENV ADMIN_API_ADDR=:8080
EXPOSE 8080
# Liveness probe — same posture as the tenant api: /livez is the lightweight
# "process is up" check (no DB ping). ECS Express + ALB use their own
# health-check path (TF-owned); this in-image HEALTHCHECK is for docker run.
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:8080/livez || exit 1
CMD ["./api-admin"]
