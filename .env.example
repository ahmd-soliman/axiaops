# AxiaOps Environment Variables — Copy to .env and fill in actual values
# For production, use GitHub Actions secrets (never commit real secrets)

# ─ DEV MODE ─────────────────────────────────────────────────────────────
# Set to "false" in production to enable Kinde JWT auth
# DEV_ORGANIZATION_ID, DEV_USER_ID, DEV_USER_EMAIL are a trio — the API ensures
# rows with these exact ids at startup, DevBypass injects them onto every
# request, and scripts/seed_test_data.sh uses the same values. If you change
# any one of them, the other two must stay consistent or dismissals/audit
# rows will reference a different tenant/user than the one serving requests.
DEV_MODE=true
DEV_ORGANIZATION_ID=dev-organization-axiaops
DEV_USER_ID=dev-user-axiaops
DEV_USER_EMAIL=dev@axiaops.local

# ─ KINDE AUTH ────────────────────────────────────────────────────────────
# Required only when DEV_MODE=false (production)
# Get these from your Kinde dashboard: https://app.kinde.com
KINDE_ISSUER=https://your-instance.kinde.com
KINDE_CLIENT_ID=your-client-id

# ─ KINDE M2M (machine-to-machine) ───────────────────────────────────────
# Required when invitations are enabled (POST /v1/invitations).
# Create a separate M2M application in Kinde with scopes:
#   read:users, create:users, update:user_properties, delete:users,
#   read:organizations, update:organizations,
#   update:organization_users, delete:organization_users
KINDE_M2M_CLIENT_ID=your-m2m-client-id
KINDE_M2M_CLIENT_SECRET=your-m2m-client-secret

# ─ ENCRYPTION ────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting secrets at rest (AWS credentials, etc.)
# Generate with: openssl rand -hex 32
# MUST be 32 bytes (64 hex characters)
ENCRYPTION_KEY=your-32-byte-hex-key-here

# ─ DATABASE ─────────────────────────────────────────────────────────────
# Set by docker-compose, but shown here for reference
# DATABASE_URL=postgres://axiaops:axiaops@localhost:5432/axiaops
# MIGRATION_DATABASE_URL=postgres://axiaops_owner:axiaops_owner@localhost:5432/axiaops

# ─ INGESTION ────────────────────────────────────────────────────────────
# How often to scan for idle resources (dev: fast for testing, prod: usually hourly)
SCAN_INTERVAL=10s

# ─ LOGGING ──────────────────────────────────────────────────────────────
# Options: "text" (default), "json"
# json is better for production, text better for local development
LOG_OUTPUT=text
LOG_LEVEL=info
